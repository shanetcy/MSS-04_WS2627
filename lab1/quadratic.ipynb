    "def q_solve(a,b,c):\n",
    "    D = (b**2)-(4*a*c)\n",
    "    if D >= 0:\n",
    "        x1 = ((-b)+(D**0.5))/(2*a)\n",
    "        x2 = ((-b)-(D**0.5))/(2*a)\n",
    "        if x1==x2:\n",
    "            return x1\n",
    "        return x1,x2\n",
    "        "
   ]
